---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';

// Gutenberg block styles
import '@wordpress/block-library/build-style/style.css';
import '@wordpress/block-library/build-style/theme.css';

// Custom utilities
import '../styles/utilities.css';

// WordPress block overrides
import '../styles/wp-blocks.css';

export interface Props {
	title: string;
	metaDescription: string;
}

const { title, metaDescription } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="description" content={metaDescription}>
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
	<title>{title}</title>
	<ViewTransitions />
	<script is:inline>
		// Prevent flash of wrong theme
		(function() {
			const savedTheme = localStorage.getItem('theme');
			if (savedTheme === 'dark') {
				document.documentElement.classList.add('dark');
			} else if (savedTheme === 'light') {
				document.documentElement.classList.add('light');
			}
		})();
	</script>
</head>

<body>
	<Header />
	<main transition:name="main-content">
		<slot />
	</main>
</body>

</html>
<style is:global>
	/* Light mode (default) */
	:root {
		--color-bg-body: #222;
		--color-bg-content: #eee;
		--color-text: #1a1a1a;
	}

	/* Dark mode via class */
	:root.dark {
		--color-bg-body: #111;
		--color-bg-content: #313131;
		--color-text: #eee;
	}

	/* Dark mode via system preference (when no manual override) */
	@media (prefers-color-scheme: dark) {
		:root:not(.light) {
			--color-bg-body: #111;
			--color-bg-content: #313131;
			--color-text: #eee;
		}
	}

	html {
		font-family: system-ui, sans-serif;
		font-size: var(--font-size-base);
		color: var(--color-text);
	}

	html.lenis {
		height: auto;
	}

	html.lenis body {
		height: auto;
	}

	body {
		background-color: var(--color-bg-body);
		min-height: 100vh;
		overflow-x: hidden;
		color: var(--color-text);
		margin: 0;
	}

	main {
		margin: auto;
		background-color: var(--color-bg-content);
		min-height: 100vh;
		padding-top: 80px;
		position: relative;
	}

	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}

	/* Header should always be on top and not animate */
	::view-transition-group(header) {
		z-index: 99999;
	}

	::view-transition-old(header),
	::view-transition-new(header) {
		animation: none;
		mix-blend-mode: normal;
	}

	/* Custom View Transition Animations - Side-by-side shrink/slide/expand */
	/* Only animate the main content, not the header */
	::view-transition-old(main-content) {
		animation: exitAnimation 800ms cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 1;
	}

	::view-transition-new(main-content) {
		animation: enterAnimation 1000ms cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 1;
	}

	::view-transition-group(main-content) {
		z-index: 1;
	}

	@keyframes exitAnimation {
		0% {
			transform: scale(1) translateX(0) translateY(0);
			border-radius: 0;
			box-shadow: none;
		}
		40% {
			transform: scale(0.6) translateX(0) translateY(0);
			border-radius: 24px;
			box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		}
		100% {
			transform: scale(0.6) translateX(-200%) translateY(0);
			border-radius: 24px;
			box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		}
	}

	@keyframes enterAnimation {
		0% {
			transform: scale(0.6) translateX(200%) translateY(0);
			border-radius: 24px;
			box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		}
		50% {
			transform: scale(0.6) translateX(0) translateY(0);
			border-radius: 24px;
			box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		}
		100% {
			transform: scale(1) translateX(0) translateY(0);
			border-radius: 0;
			box-shadow: none;
		}
	}

	/* Prevent overflow during transitions */
	::view-transition-old(main-content),
	::view-transition-new(main-content) {
		overflow: hidden;
	}
</style>

<script>
	// Dark/Light mode functionality
	function initTheme() {
		const savedTheme = localStorage.getItem('theme');
		const root = document.documentElement;

		if (savedTheme === 'dark') {
			root.classList.add('dark');
			root.classList.remove('light');
		} else if (savedTheme === 'light') {
			root.classList.add('light');
			root.classList.remove('dark');
		}
	}

	function toggleTheme() {
		const root = document.documentElement;
		const isDark = root.classList.contains('dark') ||
			(!root.classList.contains('light') && window.matchMedia('(prefers-color-scheme: dark)').matches);

		if (isDark) {
			root.classList.remove('dark');
			root.classList.add('light');
			localStorage.setItem('theme', 'light');
		} else {
			root.classList.remove('light');
			root.classList.add('dark');
			localStorage.setItem('theme', 'dark');
		}
	}

	// Initialize theme on load
	initTheme();

	// Expose toggle function globally
	(window as any).toggleTheme = toggleTheme;

	// WordPress Fit Text functionality
	function fitText() {
		const fitTextElements = document.querySelectorAll('.has-fit-text');
		fitTextElements.forEach((el) => {
			const element = el as HTMLElement;
			const container = element.parentElement;
			if (!container) return;

			element.style.fontSize = '';
			const containerWidth = container.clientWidth - 32;

			const tempSpan = document.createElement('span');
			tempSpan.style.visibility = 'hidden';
			tempSpan.style.position = 'absolute';
			tempSpan.style.whiteSpace = 'nowrap';
			tempSpan.style.font = window.getComputedStyle(element).font;
			tempSpan.innerHTML = element.innerHTML;
			document.body.appendChild(tempSpan);

			const textWidth = tempSpan.offsetWidth;
			document.body.removeChild(tempSpan);

			if (textWidth > 0) {
				const currentFontSize = parseFloat(window.getComputedStyle(element).fontSize);
				const scale = containerWidth / textWidth;
				const newFontSize = Math.floor(currentFontSize * scale);
				const finalFontSize = Math.min(Math.max(newFontSize, 16), 500);
				element.style.fontSize = `${finalFontSize}px`;
			}
		});
	}

	// WordPress Accordion Block functionality
	function handleAccordion(e: Event) {
		const target = e.target as HTMLElement;
		const accordionToggle = target.closest('.wp-block-accordion-heading__toggle');

		if (accordionToggle) {
			e.preventDefault();
			const accordionItem = accordionToggle.closest('.wp-block-accordion-item');
			if (accordionItem) {
				const isOpen = accordionItem.classList.contains('is-open');
				const panel = accordionItem.querySelector('.wp-block-accordion-panel');
				const button = accordionToggle as HTMLButtonElement;

				if (isOpen) {
					accordionItem.classList.remove('is-open');
					button.setAttribute('aria-expanded', 'false');
					if (panel) panel.setAttribute('inert', '');
				} else {
					accordionItem.classList.add('is-open');
					button.setAttribute('aria-expanded', 'true');
					if (panel) panel.removeAttribute('inert');
				}
			}
		}
	}

	// Run on initial page load
	fitText();
	window.addEventListener('resize', fitText);
	document.addEventListener('click', handleAccordion);

	// Re-run after view transitions
	document.addEventListener('astro:after-swap', () => {
		initTheme();
		fitText();
	});

	// Prevent navigation when clicking on the current page
	document.addEventListener('click', (e) => {
		const link = (e.target as HTMLElement).closest('a');
		if (!link) return;

		const href = link.getAttribute('href');
		if (!href) return;

		// Skip external links and special links
		if (href.startsWith('http') || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) {
			return;
		}

		// Check if navigating to the current page
		try {
			const targetUrl = new URL(href, window.location.origin);
			const currentUrl = new URL(window.location.href);

			// Normalize paths by removing trailing slashes
			const targetPath = targetUrl.pathname.replace(/\/$/, '') || '/';
			const currentPath = currentUrl.pathname.replace(/\/$/, '') || '/';

			// If navigating to the same page, prevent the default action
			if (targetPath === currentPath && targetUrl.hash === currentUrl.hash) {
				e.preventDefault();
				e.stopPropagation();
			}
		} catch (err) {
			// Invalid URL, let it proceed normally
		}
	}, true); // Use capture phase to catch it early
</script>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';
	import SplitType from 'split-type';

	// Register GSAP plugins
	gsap.registerPlugin(ScrollTrigger);

	let lenis: Lenis | null = null;

	function initSmoothScroll() {
		// Destroy existing Lenis instance
		if (lenis) {
			lenis.destroy();
			lenis = null;
		}

		// Create new Lenis instance for smooth scrolling
		lenis = new Lenis({
			duration: 1.2,
			easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			orientation: 'vertical',
			gestureOrientation: 'vertical',
			smoothWheel: true,
			wheelMultiplier: 1,
			smoothTouch: false,
			touchMultiplier: 2,
			infinite: false
		});

		// Connect Lenis to GSAP ScrollTrigger
		lenis.on('scroll', ScrollTrigger.update);

		// Sync ScrollTrigger with Lenis
		gsap.ticker.add((time) => {
			lenis?.raf(time * 1000);
		});

		gsap.ticker.lagSmoothing(0);
	}

	function initGSAP() {
		// Kill existing ScrollTriggers
		ScrollTrigger.getAll().forEach(trigger => trigger.kill());

		// Refresh ScrollTrigger to recalculate positions
		ScrollTrigger.refresh();

		// Helper function to get delay from element
		// Supports data-delay attribute or delay-X classes
		function getDelay(element: HTMLElement): number {
			// Check for data-delay attribute
			const dataDelay = element.dataset.delay;
			if (dataDelay) {
				return parseFloat(dataDelay) * 0.5; // Convert to seconds (delay-1 = 0.5s)
			}

			// Check for delay-X class
			const classes = Array.from(element.classList);
			const delayClass = classes.find(cls => cls.startsWith('delay-'));
			if (delayClass) {
				const delayValue = parseInt(delayClass.replace('delay-', ''));
				return delayValue * 0.5; // Convert to seconds (delay-1 = 0.5s, delay-2 = 1.0s)
			}

			return 0;
		}

		// Animate elements with .grow-on-scroll class
		// Scales from 0.6 to 1 as element enters viewport
		gsap.utils.toArray('.grow-on-scroll').forEach((element: any) => {
			const delay = getDelay(element);

			gsap.fromTo(element,
				{
					scale: 0.6,
					transformOrigin: 'center center'
				},
				{
					scale: 1,
					duration: 1,
					ease: 'power2.out',
					delay: delay,
					scrollTrigger: {
						trigger: element,
						start: 'top 80%',
						end: 'top 20%',
						scrub: 1
					}
				}
			);
		});

		// Animate elements with .fade-in-up class
		// Fades in and moves up smoothly when entering viewport
		gsap.utils.toArray('.fade-in-up').forEach((element: any) => {
			const delay = getDelay(element);

			gsap.fromTo(element,
				{
					opacity: 0,
					y: 60
				},
				{
					opacity: 1,
					y: 0,
					duration: 1.2,
					ease: 'power2.out',
					delay: delay,
					scrollTrigger: {
						trigger: element,
						start: 'top 85%',
						end: 'top 50%',
						scrub: 1
					}
				}
			);
		});

		// Split text animations - Characters
		// Animates each character individually with stagger
		gsap.utils.toArray('.split-chars').forEach((element: any) => {
			const split = new SplitType(element, { types: 'chars' });
			const delay = getDelay(element);

			gsap.from(split.chars, {
				opacity: 0,
				y: 20,
				rotateX: -90,
				stagger: 0.02,
				duration: 0.8,
				delay: delay,
				ease: 'back.out(1.7)',
				scrollTrigger: {
					trigger: element,
					start: 'top 80%',
					toggleActions: 'play none none reverse'
				}
			});
		});

		// Split text animations - Words
		// Animates each word individually with stagger
		gsap.utils.toArray('.split-words').forEach((element: any) => {
			const split = new SplitType(element, { types: 'words' });
			const delay = getDelay(element);

			gsap.from(split.words, {
				opacity: 0,
				y: 30,
				rotateY: 90,
				stagger: 0.05,
				duration: 1,
				delay: delay,
				ease: 'power3.out',
				scrollTrigger: {
					trigger: element,
					start: 'top 75%',
					toggleActions: 'play none none reverse'
				}
			});
		});

		// Split text animations - Lines
		// Animates each line individually
		gsap.utils.toArray('.split-lines').forEach((element: any) => {
			const split = new SplitType(element, { types: 'lines' });
			const delay = getDelay(element);

			gsap.from(split.lines, {
				opacity: 0,
				y: 50,
				stagger: 0.1,
				duration: 1.2,
				delay: delay,
				ease: 'power2.out',
				scrollTrigger: {
					trigger: element,
					start: 'top 80%',
					toggleActions: 'play none none reverse'
				}
			});
		});

		// Fancy reveal - Characters with color and scale
		gsap.utils.toArray('.text-reveal').forEach((element: any) => {
			const split = new SplitType(element, { types: 'chars' });
			const delay = getDelay(element);

			gsap.from(split.chars, {
				opacity: 0,
				scale: 0,
				y: 80,
				rotateZ: 180,
				transformOrigin: '0% 50% -50',
				stagger: 0.03,
				duration: 1,
				delay: delay,
				ease: 'elastic.out(1, 0.5)',
				scrollTrigger: {
					trigger: element,
					start: 'top 75%',
					toggleActions: 'play none none reverse'
				}
			});
		});

		// Parallax effect for images
		// Images move slower than scroll creating depth
		gsap.utils.toArray('.parallax').forEach((element: any) => {
			const speed = element.dataset.speed || 0.5;
			const delay = getDelay(element);

			gsap.to(element, {
				y: () => -window.innerHeight * parseFloat(speed),
				ease: 'none',
				delay: delay,
				scrollTrigger: {
					trigger: element,
					start: 'top bottom',
					end: 'bottom top',
					scrub: 1
				}
			});
		});

		// Parallax zoom effect
		// Images scale up as you scroll
		gsap.utils.toArray('.parallax-zoom').forEach((element: any) => {
			const delay = getDelay(element);

			gsap.fromTo(element,
				{
					scale: 1.2
				},
				{
					scale: 1,
					ease: 'none',
					delay: delay,
					scrollTrigger: {
						trigger: element,
						start: 'top bottom',
						end: 'bottom top',
						scrub: 1
					}
				}
			);
		});

		// Parallax reveal - image reveals as you scroll
		gsap.utils.toArray('.parallax-reveal').forEach((element: any) => {
			const container = element.parentElement;
			const delay = getDelay(element);

			gsap.fromTo(element,
				{
					yPercent: -20,
					scale: 1.3
				},
				{
					yPercent: 20,
					scale: 1,
					ease: 'none',
					delay: delay,
					scrollTrigger: {
						trigger: container || element,
						start: 'top bottom',
						end: 'bottom top',
						scrub: 1
					}
				}
			);
		});

		// Ticker text effect - scrolls from right to left based on scroll
		gsap.utils.toArray('.ticker-text').forEach((element: any) => {
			const delay = getDelay(element);

			// Get the width of the text to calculate movement
			const textWidth = element.scrollWidth;

			gsap.to(element, {
				x: -textWidth,
				ease: 'none',
				delay: delay,
				scrollTrigger: {
					trigger: element,
					start: 'top bottom',
					end: 'bottom top',
					scrub: 1
				}
			});
		});
	}

	function init() {
		initSmoothScroll();
		initGSAP();
	}

	// Initialize on load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}

	// Re-initialize after view transitions
	document.addEventListener('astro:after-swap', () => {
		// Small delay to ensure DOM is ready
		setTimeout(init, 100);
	});
</script>
