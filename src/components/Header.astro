---
import { getMenuByLocation, getSiteSettings, getSiteLogoById } from '../lib/queries'

interface MenuItem {
    id: string;
    label: string;
    url: string;
    path: string;
    parentId: string | null;
    cssClasses: string[] | null;
}

const apiUrl = `${import.meta.env.WORDPRESS_URL}/${import.meta.env.GRAPHQL_API_PATH}`;
const wpUrl = import.meta.env.WORDPRESS_URL;

// Fetch menu and site settings in parallel
const [menuResponse, siteResponse] = await Promise.all([
    fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            query: getMenuByLocation,
            variables: {
                location: 'PRIMARY',
            },
        }),
    }),
    fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            query: getSiteSettings,
        }),
    }),
]);

const menuJson = await menuResponse.json();
const siteJson = await siteResponse.json();

const menuItems: MenuItem[] = menuJson.data?.menuItems?.nodes ?? [];
const siteTitle = siteJson.data?.generalSettings?.title ?? 'Site';

// Get the custom_logo ID from WordPress using the index endpoint
let siteLogo = null;
try {
    const indexResponse = await fetch(`${wpUrl}/wp-json`);
    if (indexResponse.ok) {
        const indexData = await indexResponse.json();
        const logoId = indexData.site_logo;

        if (logoId) {
            // Fetch the logo media item via GraphQL
            const logoResponse = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    query: getSiteLogoById,
                    variables: {
                        id: String(logoId),
                    },
                }),
            });
            const logoJson = await logoResponse.json();
            siteLogo = logoJson.data?.mediaItem;
        }
    }
} catch (e) {
    // Logo fetch failed, will use site title as fallback
}

// Build mega menu tree: top-level items become columns, children fill each column
const topLevelItems = menuItems.filter((item) => !item.parentId);
const menuTree = topLevelItems.map((item) => ({
    ...item,
    children: menuItems.filter((child) => child.parentId === item.id),
}));
---

<header class="header" transition:name="header" transition:animate="none">
    <div class="header-card" id="header-card">
        <nav class="nav-container">
            <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mega-menu">
                <span class="menu-icon"></span>
                <span class="menu-text">Menu</span>
            </button>

            <a href="/" class="site-logo">
                {siteLogo?.sourceUrl ? (
                    <img
                        src={siteLogo.sourceUrl}
                        alt={siteLogo.altText || siteTitle}
                        class="logo-img"
                    />
                ) : (
                    siteTitle
                )}
            </a>

            <div class="nav-actions">
                <a href="/join" class="btn btn-primary">Join</a>
            </div>
        </nav>

        <div class="mega-menu" id="mega-menu" role="navigation" aria-label="Main navigation">
            <div class="mega-menu-body">
                <div class="mega-menu-inner">
                    {menuTree.map((col) => (
                        <div class="mega-col">
                            <a
                                href={col.path || col.url}
                                class={`mega-col-heading ${col.cssClasses?.join(' ') || ''}`}
                            >
                                {col.label}
                            </a>
                            {col.children.length > 0 && (
                                <ul class="mega-col-list">
                                    {col.children.map((child) => (
                                        <li class="mega-col-item">
                                            <a
                                                href={child.path || child.url}
                                                class={child.cssClasses?.join(' ') || ''}
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 99999;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;
        isolation: isolate;
    }

    .header-card {
        background-color: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
        max-width: 700px;
        width: 100%;
        transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .header-card.menu-open {
        max-width: 900px;
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.5rem 0.5rem 1.25rem;
        gap: 1rem;
    }

    .menu-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: none;
        border: none;
        color: #fff;
        cursor: pointer;
        padding: 0.5rem;
        font-size: 0.875rem;
        min-width: 100px;
    }

    .menu-icon {
        display: flex;
        flex-direction: column;
        gap: 3px;
        width: 16px;
    }

    .menu-icon::before,
    .menu-icon::after {
        content: '';
        display: block;
        height: 2px;
        background-color: #fff;
        border-radius: 1px;
        transition: transform 0.2s, opacity 0.2s;
    }

    /* X state when open */
    .menu-toggle[aria-expanded="true"] .menu-icon::before {
        transform: translateY(3.5px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .menu-icon::after {
        transform: translateY(-3.5px) rotate(-45deg);
    }

    .menu-text {
        font-weight: 500;
    }

    .site-logo {
        color: #fff;
        font-size: 1.25rem;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: 0.1em;
        display: flex;
        align-items: center;
    }

    .logo-img {
        height: 38px;
        width: auto;
        object-fit: contain;
    }

    .nav-actions {
        display: flex;
        gap: 0.25rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .btn:hover {
        opacity: 0.9;
    }

    .btn-secondary {
        background-color: #4a4a4a;
        color: #fff;
    }

    .btn-primary {
        background-color: #f6f5d2;
        color: #000;
        border: 0;
        min-width: 100px;
    }

    /* ── Mega menu panel ── */
    .mega-menu {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mega-menu.active {
        grid-template-rows: 1fr;
    }

    /* overflow:hidden needed for grid-row height collapse trick */
    .mega-menu-body {
        overflow: hidden;
        min-height: 0;
        border-top: 1px solid #2e2e2e;
    }

    .mega-menu-inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0;
        padding: 1.5rem;
        transform: translateY(-6px);
        transition: transform 0.25s ease 0.1s, opacity 0.25s ease 0.1s;
        opacity: 0;
    }

    .mega-menu.active .mega-menu-inner {
        transform: translateY(0);
        opacity: 1;
    }

    /* ── Column ── */
    .mega-col {
        padding: 0 1rem;
        border-left: 1px solid #2e2e2e;
    }

    .mega-col:first-child {
        border-left: none;
        padding-left: 0;
    }

    .mega-col:last-child {
        padding-right: 0;
    }

    /* Column heading = top-level menu item */
    .mega-col-heading {
        display: block;
        color: #f6f5d2;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        padding-bottom: 0.75rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid #2e2e2e;
        transition: color 0.2s;
    }

    .mega-col-heading:hover {
        color: #fff;
    }

    /* Sub-menu items */
    .mega-col-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .mega-col-item a {
        display: block;
        padding: 0.4rem 0.5rem;
        color: #aaa;
        font-size: 0.875rem;
        text-decoration: none;
        border-radius: 0.375rem;
        transition: background-color 0.15s, color 0.15s;
    }

    .mega-col-item a:hover {
        background-color: #2a2a2a;
        color: #fff;
    }

    /* ── Mobile: stack columns vertically ── */
    @media (max-width: 600px) {
        .header-card.menu-open {
            max-width: 100%;
        }

        .mega-menu-inner {
            grid-template-columns: 1fr;
            padding: 1rem;
        }

        .mega-col {
            border-left: none;
            border-top: 1px solid #2e2e2e;
            padding: 1rem 0 0;
        }

        .mega-col:first-child {
            border-top: none;
            padding-top: 0;
        }
    }
</style>

<script is:inline>
    (function() {
        function setupMenu() {
            const menuToggle = document.querySelector('.menu-toggle');
            const megaMenu = document.getElementById('mega-menu');
            const headerCard = document.getElementById('header-card');

            if (!menuToggle || !megaMenu || !headerCard) return;
            if (menuToggle.hasAttribute('data-menu-initialized')) return;

            menuToggle.setAttribute('data-menu-initialized', 'true');

            function openMenu() {
                megaMenu.classList.add('active');
                headerCard.classList.add('menu-open');
                menuToggle.setAttribute('aria-expanded', 'true');
            }

            function closeMenu() {
                megaMenu.classList.remove('active');
                headerCard.classList.remove('menu-open');
                menuToggle.setAttribute('aria-expanded', 'false');
            }

            menuToggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                megaMenu.classList.contains('active') ? closeMenu() : openMenu();
            });

            document.addEventListener('click', function(e) {
                if (!menuToggle.contains(e.target) && !megaMenu.contains(e.target)) {
                    closeMenu();
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupMenu);
        } else {
            setupMenu();
        }

        document.addEventListener('astro:page-load', setupMenu);

        document.addEventListener('astro:before-preparation', function() {
            const megaMenu = document.getElementById('mega-menu');
            const menuToggle = document.querySelector('.menu-toggle');
            const headerCard = document.getElementById('header-card');
            if (megaMenu) megaMenu.classList.remove('active');
            if (headerCard) headerCard.classList.remove('menu-open');
            if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
        });
    })();
</script>
